---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="聯絡我們 | 臺灣高效能運算教育協會"
  description="聯絡臺灣高效能運算教育協會，洽詢課程、研究專案、會員與合作事宜。"
>
  <Header />
  <main>
    <section class="py-16 bg-cream-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-dark-800 mb-6">聯絡我們</h1>
          <p class="text-xl text-dark-700 max-w-3xl mx-auto">
            歡迎與臺灣高效能運算教育協會聯繫，我們期待與您的合作與交流。
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-cream-50 rounded-xl shadow-lg p-8 md:p-12 text-center">
          <div class="w-16 h-16 bg-secondary-200 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-secondary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-dark-800 mb-4">使用電子郵件聯絡</h2>
          <p class="text-lg text-dark-700 mb-8">
            課程、專案、會員或合作提案，請寄信至協會聯絡信箱。我們會由適合的窗口回覆。
          </p>
          <a
            href="mailto:contact@twhpcedu.org"
            class="inline-flex items-center justify-center bg-primary-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-primary-700 transition-colors"
          >
            寄信至 contact@twhpcedu.org
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
