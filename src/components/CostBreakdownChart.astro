<script>
  import Chart from 'chart.js/auto';

  const percentageLabels = {
    id: 'percentageLabels',
    afterDatasetsDraw(chart) {
      const dataset = chart.data.datasets[0];
      const metadata = chart.getDatasetMeta(0);
      const fontSize = Math.max(14, Math.min(19, chart.width / 24));

      chart.ctx.save();
      chart.ctx.fillStyle = '#ffffff';
      chart.ctx.font = `600 ${fontSize}px Inter, system-ui, sans-serif`;
      chart.ctx.textAlign = 'center';
      chart.ctx.textBaseline = 'middle';

      metadata.data.forEach((arc, index) => {
        const position = arc.tooltipPosition();
        chart.ctx.fillText(`${dataset.data[index]}%`, position.x, position.y);
      });

      chart.ctx.restore();
    },
  };

  function renderCostCharts() {
    document.querySelectorAll('[data-cost-breakdown-chart]').forEach((chartRoot) => {
      const canvas = chartRoot.querySelector('canvas');
      if (!(canvas instanceof HTMLCanvasElement) || Chart.getChart(canvas)) return;

      new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: [
            '雲端運算服務器租用',
            '雲端資料庫空間租用',
            'Gen AI 運算資源訂閱',
            '行政規費負擔',
          ],
          datasets: [{
            data: [31, 26, 26, 17],
            backgroundColor: ['#2B63E5', '#38AFE5', '#7C86EE', '#94A3B8'],
            borderColor: '#ffffff',
            borderWidth: 6,
            borderRadius: 3,
            spacing: 2,
            hoverOffset: 4,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '58%',
          animation: false,
          plugins: {
            legend: {
              display: false,
            },
            tooltip: {
              callbacks: {
                title() {
                  return [];
                },
                label(context) {
                  return `${context.label}：${context.parsed}%`;
                },
              },
            },
          },
        },
        plugins: [percentageLabels],
      });
    });
  }

  renderCostCharts();
  document.addEventListener('astro:page-load', renderCostCharts);
</script>

