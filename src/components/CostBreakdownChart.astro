  }

  .cost-breakdown-chart__canvas {
    position: relative;
    width: min(100%, 28rem);
    aspect-ratio: 1;
    margin: 0 auto;
  }

  .cost-breakdown-chart__canvas canvas {
    width: 100% !important;
    height: 100% !important;
  }

  .prose .cost-breakdown-chart__legend {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prose .cost-breakdown-chart__legend li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
    margin: 0;
    padding: 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: #ffffff;
    line-height: 1.5;
  }

  .cost-breakdown-chart__swatch {
    width: 0.75rem;
